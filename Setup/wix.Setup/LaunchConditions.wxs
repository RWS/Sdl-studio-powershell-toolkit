<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Fragment>
		<!-- Directory Search for Trados Studio 2022 (Studio17) -->
		<Property Id="TRADOS2022_INSTALL">
			<DirectorySearch Id="TradosStudio2021DirectoryCheck" Path="[ProgramFilesFolder]Trados\Trados Studio\Studio17" Depth="0" />
		</Property>

		<!-- Directory Search for Trados Studio 2024 (Studio18) -->
		<Property Id="TRADOS2024_INSTALL">
			<DirectorySearch Id="TradosStudio2022DirectoryCheck" Path="[ProgramFilesFolder]Trados\Trados Studio\Studio18" Depth="0" />
		</Property>

		<!-- Directory Search for Trados Studio 2026 (Studio19) - 64-bit, installed under Program Files -->
		<Property Id="TRADOS2026_INSTALL">
			<DirectorySearch Id="TradosStudio2026DirectoryCheck" Path="[ProgramFiles64Folder]Trados\Trados Studio\Studio19" Depth="0" />
		</Property>

		<!-- Launch Condition for Trados Studio 2022, 2024 or 2026 -->
		<Launch Condition="Installed OR (TRADOS2022_INSTALL OR TRADOS2024_INSTALL OR TRADOS2026_INSTALL)" Message="Trados Studio 2022, 2024 or 2026 must be installed to proceed with this installation." />

		<!-- PowerShell 5 (x86) Registry Search - required for Trados Studio 2022/2024 -->
		<Property Id="POWERSHELL5">
			<RegistrySearch Id="PowerShell5RegistryCheck" Root="HKLM" Key="SOFTWARE\WOW6432Node\Microsoft\PowerShell\3\PowerShellEngine" Name="PowerShellVersion" Type="raw" Bitness="always32" />
		</Property>

		<!-- PowerShell 5 (x64) Registry Search - required for Trados Studio 2026 -->
		<Property Id="POWERSHELL5_X64">
			<RegistrySearch Id="PowerShell5X64RegistryCheck" Root="HKLM" Key="SOFTWARE\Microsoft\PowerShell\3\PowerShellEngine" Name="PowerShellVersion" Type="raw" Bitness="always64" />
		</Property>

		<!-- Launch Condition for PowerShell 5 (x86 or x64) -->
		<Launch Condition="Installed OR (POWERSHELL5 AND POWERSHELL5 &gt;= &quot;5.0&quot; AND POWERSHELL5 &lt; &quot;6.0&quot;) OR (POWERSHELL5_X64 AND POWERSHELL5_X64 &gt;= &quot;5.0&quot; AND POWERSHELL5_X64 &lt; &quot;6.0&quot;)" Message="PowerShell 5 (x86 or x64) is required to install this application." />
		<ComponentGroup Id="LaunchConditions" />
	</Fragment>
</Wix>
