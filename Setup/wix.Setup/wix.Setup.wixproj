<Project Sdk="WixToolset.Sdk/5.0.2">
  <!-- WiX v5 SDK-style project: builds with `dotnet build`, no Visual Studio extension needed.
       All *.wxs / *.wxi files in this folder are compiled automatically. -->
  <PropertyGroup>
    <OutputName>wix.Setup</OutputName>
    <InstallerPlatform>x86</InstallerPlatform>
    <DefineConstants Condition=" '$(Configuration)' == 'Debug' ">Debug</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>
