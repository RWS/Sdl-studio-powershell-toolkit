<?include Defines.wxi ?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
	<Package Name="$(var.appName)" Language="1033" Version="$(var.productVersion)" Manufacturer="$(var.manufacturer)" UpgradeCode="$(var.upgradeCode)" InstallerVersion="200" Scope="perUser">
		
		

		<MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

		<Icon Id="Studio_Toolkit.ico" SourceFile="Studio_Toolkit.ico" />
		<Property Id="ARPPRODUCTICON" Value="Studio_Toolkit.ico" />

		<Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
		<SetProperty Id="INSTALLDIR" Value="[PersonalFolder]WindowsPowerShell" Before="CostFinalize" Sequence="first" />
		<UIRef Id="WixUI_MyInstallDir" />

		<MediaTemplate EmbedCab="yes" />

		<FeatureGroupRef Id="ToolkitFeatures" />
	</Package>

</Wix>